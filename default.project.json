{
  "name": "prototipo",
  "globIgnorePaths": ["**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Compartilhado": { "$path": "src/shared" }
    },

    "ServerScriptService": {
      "Jogo": { "$path": "src/server" }
    },

    "ServerStorage": {
      "Itens": { "$path": "assets/Itens" }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Cliente": { "$path": "src/client" }
      }
    }
  }
}
